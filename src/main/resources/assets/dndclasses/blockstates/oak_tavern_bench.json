{
  "multipart": [
    {
      "apply": {
        "model": "dndclasses:block/oak_tavern_bench_seat"
      },
      "when": {
        "axis": "z"
      }
    },
    {
      "apply": {
        "model": "dndclasses:block/oak_tavern_bench_seat",
        "y": 90
      },
      "when": {
        "axis": "x"
      }
    },
    {
      "apply": {
        "model": "dndclasses:block/oak_tavern_bench_leg"
      },
      "when": {
        "axis": "z",
        "north": "false"
      }
    },
    {
      "apply": {
        "model": "dndclasses:block/oak_tavern_bench_leg",
        "y": 180
      },
      "when": {
        "axis": "z",
        "south": "false"
      }
    },
    {
      "apply": {
        "model": "dndclasses:block/oak_tavern_bench_leg",
        "y": 90
      },
      "when": {
        "axis": "x",
        "east": "false"
      }
    },
    {
      "apply": {
        "model": "dndclasses:block/oak_tavern_bench_leg",
        "y": 270
      },
      "when": {
        "axis": "x",
        "west": "false"
      }
    }
  ]
}

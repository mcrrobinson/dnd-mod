{
  "multipart": [
    {
      "apply": {
        "model": "dndclasses:block/tent_stake_post"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "dndclasses:block/tent_stake_side"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "dndclasses:block/tent_stake_side",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "dndclasses:block/tent_stake_side",
        "y": 180
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "dndclasses:block/tent_stake_side",
        "y": 270
      }
    }
  ]
}

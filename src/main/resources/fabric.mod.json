{
    "schemaVersion": 1,
    "id": "dndclasses",
    "version": "${version}",
    "name": "DND Classes",
    "description": "Adds DND classes to minecraft.",
    "authors": [
        "mattonfire"
    ],
    "contact": {
        "homepage": "https://github.com/mcrrobinson/dnd-mod",
        "sources": "https://github.com/mcrrobinson/dnd-mod"
    },
    "license": "GPL-3.0-or-later",
    "icon": "assets/dndclasses/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "mattonfire.dnd.classes.DnDClasses"
        ],
        "client": [
            "mattonfire.dnd.classes.Client.DndClassesClient"
        ]
    },
    "mixins": [
        "dndclasses.mixins.json"
    ],
    "accessWidener": "dndclasses.accesswidener",
    "depends": {
        "fabricloader": ">=0.16.0",
        "fabric-api": ">=0.87.0",
        "minecraft": "1.19.4",
        "java": ">=17",
        "geckolib": ">=4.2"
    },
    "recommends": {
        "identity": ">=2.7.0-1.19.4"
    }
}
